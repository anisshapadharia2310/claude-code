// ---------------------------------------------------------------------------
// Project SIGNAL - Scored Intent and Granular Account-Level Listbuilding
// PostgreSQL schema.
//
// Design notes:
//  * Every state that drives a business rule is an enum, so an invalid state is
//    unrepresentable rather than validated at runtime.
//  * Scores are stored alongside a JSON breakdown so the UI can always explain
//    a number without recomputing it.
//  * ScoreAudit is append-only: score history is never overwritten.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------- enums -------------------------------------

enum UserRole {
  ADMIN
  RESEARCHER
  CALLER
  MANAGER
}

enum CampaignType {
  WHITE_PAPER
  WEBINAR
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum RoleCategory {
  DIRECT_OWNER
  OPERATIONAL_OWNER
  EXECUTIVE_SPONSOR
  TECHNICAL_EVALUATOR
  BUSINESS_INFLUENCER
  PROCUREMENT
  END_USER
  PERIPHERAL
  UNKNOWN
}

enum Seniority {
  C_LEVEL
  EVP
  SVP
  VP
  HEAD
  DIRECTOR
  SENIOR_MANAGER
  MANAGER
  TEAM_LEAD
  SENIOR_INDIVIDUAL
  INDIVIDUAL
  UNKNOWN
}

enum DecisionRole {
  DECISION_MAKER
  INFLUENCER
  EVALUATOR
  RECOMMENDER
  GATEKEEPER
  END_USER
  UNKNOWN
}

enum Priority {
  P1
  P2
  P3
  REJECT
  COMPLIANCE_HOLD
  UNSCORED
}

enum EmailStatus {
  VERIFIED
  VALID
  CATCH_ALL
  UNVERIFIED
  RISKY
  INVALID
  BOUNCED
  MISSING
}

enum PhoneStatus {
  VERIFIED
  VALID
  UNVERIFIED
  INVALID
  WRONG_NUMBER
  DO_NOT_CALL
  MISSING
}

enum WhatsAppStatus {
  AVAILABLE_OPTED_IN
  AVAILABLE_NO_CONSENT
  NOT_AVAILABLE
  OPTED_OUT
  BLOCKED_BY_POLICY
  UNKNOWN
}

enum ConsentStatus {
  EXPLICIT_OPT_IN
  SOFT_OPT_IN
  LEGITIMATE_INTEREST
  NOT_CAPTURED
  OPT_OUT
  DO_NOT_CONTACT
}

enum LawfulBasis {
  CONSENT
  LEGITIMATE_INTEREST
  CONTRACT
  LEGAL_OBLIGATION
  NOT_DETERMINED
}

enum OptOutStatus {
  NONE
  EMAIL_OPT_OUT
  PHONE_OPT_OUT
  WHATSAPP_OPT_OUT
  GLOBAL_OPT_OUT
}

enum Channel {
  EMAIL
  PHONE
  WHATSAPP
  SMS
  LINKEDIN
  POST
}

enum DataConfidence {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum TriggerVerification {
  VERIFIED
  UNVERIFIED
  FALSE_POSITIVE
  NONE
}

enum ExistingClientRelationship {
  NONE
  PROSPECT
  PAST_CLIENT
  CURRENT_CLIENT
  PARTNER
}

enum EmployeeBand {
  BAND_1_50
  BAND_51_200
  BAND_201_500
  BAND_501_1000
  BAND_1001_5000
  BAND_5001_10000
  BAND_10000_PLUS
  UNKNOWN
}

enum RevenueBand {
  UNDER_10M
  USD_10M_50M
  USD_50M_250M
  USD_250M_1B
  USD_1B_5B
  OVER_5B
  UNKNOWN
}

enum ReviewStatus {
  NOT_REQUIRED
  PENDING
  IN_REVIEW
  APPROVED
  DOWNGRADED
  REJECTED
}

enum OutreachStatus {
  NEW
  ASSIGNED
  ATTEMPTED
  CONTACTED
  ENGAGED
  REGISTERED
  ATTENDED
  MEETING_SET
  NURTURE
  CLOSED_LOST
  DO_NOT_CONTACT
}

enum EventType {
  WHITEPAPER_SENT
  WHITEPAPER_DELIVERED
  WHITEPAPER_OPENED
  WHITEPAPER_DOWNLOADED
  EMAIL_SENT
  EMAIL_DELIVERED
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_REPLIED
  POSITIVE_EMAIL_REPLY
  WEBINAR_INVITATION_SENT
  WEBINAR_REGISTERED
  WEBINAR_ATTENDED
  WEBINAR_ATTENDANCE_50_PERCENT
  WEBINAR_ATTENDANCE_75_PERCENT
  WEBINAR_ATTENDANCE_80_PERCENT
  STAYED_FOR_QA
  POLL_ANSWERED
  QUESTION_ASKED
  RESOURCE_DOWNLOADED
  CTA_CLICKED
  REPLAY_WATCHED
  MEETING_REQUESTED
  CALL_CONNECTED
  CALL_NO_ANSWER
  CALL_CALLBACK_REQUESTED
  NOT_INTERESTED
  OPTED_OUT
}

enum CallOutcome {
  CONNECTED
  NO_ANSWER
  BUSY
  CALLBACK_REQUESTED
  INTERESTED
  SENT_WHITEPAPER
  SENT_WEBINAR_LINK
  REGISTERED
  NOT_RELEVANT
  NOT_INTERESTED
  WRONG_NUMBER
  DO_NOT_CONTACT
}

enum EmailType {
  WHITEPAPER_OFFER
  WEBINAR_INVITATION
  WEBINAR_REMINDER
  FOLLOW_UP
  REPLAY_SHARE
  NURTURE
  MEETING_REQUEST
}

enum WhatsAppMessageType {
  WEBINAR_INVITATION
  WEBINAR_REMINDER
  WHITEPAPER_SHARE
  FOLLOW_UP
  MEETING_CONFIRMATION
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  BOUNCED
  FAILED
  BLOCKED
  LOGGED_ONLY
}

enum ReplySentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  OUT_OF_OFFICE
  UNSUBSCRIBE
  REFERRAL
}

enum ScoreChangeReason {
  INITIAL_SCORE
  RESCORE
  ENGAGEMENT_EVENT
  MANUAL_REVIEW
  WEIGHT_CHANGE
  DATA_UPDATE
  COMPLIANCE_CHANGE
  IMPORT
}

// ------------------------------- models ------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  role         UserRole @default(RESEARCHER)
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedCampaignContacts CampaignContact[]  @relation("AssignedCaller")
  reviewedCampaignContacts CampaignContact[]  @relation("Reviewer")
  callActivities           CallActivity[]
  complianceReviews        ComplianceRecord[]
  scoreAudits              ScoreAudit[]

  @@index([role])
}

/// A company. Everything needed to answer "is this company a fit?" and
/// "is something happening there right now?".
model Account {
  id                          String                     @id @default(cuid())
  companyName                 String
  domain                      String?
  industry                    String
  subIndustry                 String?
  country                     String
  city                        String?
  region                      String?
  timeZone                    String?
  language                    String?
  employeeBand                EmployeeBand               @default(UNKNOWN)
  revenueBand                 RevenueBand                @default(UNKNOWN)
  numberOfLocations           Int?
  existingTechnology          String[]                   @default([])
  competitorTechnology        String[]                   @default([])
  namedAccountStatus          Boolean                    @default(false)
  existingClientRelationship  ExistingClientRelationship @default(NONE)
  // --- business trigger evidence ---
  recentBusinessTrigger       String?
  relevantOpenJobPostings     Int                        @default(0)
  transformationActivity      Boolean                    @default(false)
  expansionActivity           Boolean                    @default(false)
  mergerOrAcquisitionActivity Boolean                    @default(false)
  leadershipChange            Boolean                    @default(false)
  regulatoryPressure          Boolean                    @default(false)
  /// A priority the company has stated publicly (annual report, press release,
  /// earnings call). Scores band C "publicly stated priority or problem".
  publiclyStatedPriority      String?
  triggerSourceUrl            String?
  triggerDate                 DateTime?
  triggerVerification         TriggerVerification        @default(NONE)
  accountNotes                String?
  accountDataConfidence       DataConfidence             @default(UNKNOWN)
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  contacts Contact[]

  @@unique([companyName, country])
  @@index([domain])
  @@index([industry])
  @@index([country])
}

/// A person. Role ownership fields are deliberately separate from jobTitle:
/// a title is evidence, not qualification.
model Contact {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  firstName          String
  lastName           String
  jobTitle           String
  /// Title after normalization (lowercased, abbreviations expanded, noise
  /// stripped). This - not the raw title - feeds classification.
  normalizedJobTitle String
  department         String?
  roleCategory       RoleCategory @default(UNKNOWN)
  seniority          Seniority    @default(UNKNOWN)
  decisionRole       DecisionRole @default(UNKNOWN)

  ownsBudget                  Boolean        @default(false)
  influencesDecision          Boolean        @default(false)
  /// True only when a researcher has evidence the person is accountable for
  /// the problem the campaign addresses. Never inferred from a keyword.
  directProblemResponsibility Boolean        @default(false)
  roleRelevanceNotes          String?
  roleConfidence              DataConfidence @default(UNKNOWN)
  tenureMonths                Int?

  country  String
  city     String?
  timeZone String?
  language String?

  workEmail       String?
  emailStatus     EmailStatus    @default(MISSING)
  emailConfidence Int            @default(0)
  phoneNumber     String?
  phoneStatus     PhoneStatus    @default(MISSING)
  whatsappStatus  WhatsAppStatus @default(UNKNOWN)
  linkedinUrl     String?

  contactSource  String?
  lastVerifiedAt DateTime?

  consentStatus             ConsentStatus @default(NOT_CAPTURED)
  communicationRestrictions String[]      @default([])
  contactNotes              String?

  /// Set by the import de-duplicator; a contact pointing at another is never
  /// scored above REJECT.
  duplicateOfId String?
  isDuplicate   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignContacts  CampaignContact[]
  engagementEvents  EngagementEvent[]
  complianceRecords ComplianceRecord[]

  @@index([accountId])
  @@index([workEmail])
  @@index([phoneNumber])
  @@index([roleCategory])
  @@index([country])
  @@index([lastVerifiedAt])
}

/// A client campaign: a white paper or a webinar, with its targeting criteria.
model Campaign {
  id                    String       @id @default(cuid())
  name                  String
  clientBrand           String
  campaignType          CampaignType
  topic                 String
  targetBusinessProblem String
  description           String?

  targetIndustries     String[]       @default([])
  targetSubIndustries  String[]       @default([])
  targetCountries      String[]       @default([])
  targetCities         String[]       @default([])
  targetEmployeeBands  EmployeeBand[] @default([])
  targetRevenueBands   RevenueBand[]  @default([])
  targetTechnologies   String[]       @default([])
  targetJobFunctions   String[]       @default([])
  targetRoleCategories RoleCategory[] @default([])
  targetSeniorities    Seniority[]    @default([])
  preferredLanguages   String[]       @default([])

  /// Terms that indicate the contact genuinely owns the campaign problem, and
  /// terms that look relevant but are not. Both are matched against the
  /// normalized title plus department - never the raw title alone.
  relevantTitleTerms  String[] @default([])
  excludedTitleTerms  String[] @default([])
  relevantDepartments String[] @default([])

  eventDate          DateTime?
  eventTime          String?
  eventTimeZone      String?
  speakerInformation String?
  registrationUrl    String?
  whitePaperUrl      String?

  /// Total campaign cost, used for cost-per-verified-attendee. Editable.
  campaignCost     Decimal? @db.Decimal(12, 2)
  campaignCurrency String   @default("USD")

  /// Channels the agency is allowed to use on this campaign at all, before any
  /// per-contact or per-country compliance check.
  allowedChannels Channel[] @default([EMAIL, PHONE])

  status    CampaignStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  campaignContacts CampaignContact[]
  engagementEvents EngagementEvent[]
  scoringConfig    ScoringConfig?

  @@index([status])
  @@index([campaignType])
}

/// A contact's participation in one campaign. This is where scoring lives -
/// the same person can be a P1 for a customer-service campaign and a REJECT
/// for an energy-infrastructure campaign.
model CampaignContact {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // --- score bands (see src/domain/scoring.ts) ---
  fitScore                  Int @default(0) // max 25
  roleRelevanceScore        Int @default(0) // max 25
  triggerScore              Int @default(0) // max 20
  engagementScore           Int @default(0) // max 15
  dataQualityScore          Int @default(0) // max 10
  attendanceLikelihoodScore Int @default(0) // max 5
  /// Post-webinar bonus applied on top of the base bands; total is capped at 100.
  engagementBonusScore      Int @default(0)
  totalScore                Int @default(0)

  priority Priority @default(UNSCORED)

  relevanceGatePassed  Boolean  @default(false)
  complianceGatePassed Boolean  @default(false)
  gateFailureReasons   String[] @default([])
  gateWarnings         String[] @default([])

  humanReviewRequired Boolean      @default(false)
  humanReviewStatus   ReviewStatus @default(NOT_REQUIRED)
  humanReviewReasons  String[]     @default([])
  reviewedById        String?
  reviewedBy          User?        @relation("Reviewer", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  reviewNotes         String?

  /// Mandatory before a P1 can be approved and exported. Written by a person.
  whyThisContact         String?
  /// Engine-generated starting point for the justification above. Kept apart so
  /// that a generated sentence can never satisfy the P1 justification rule.
  whyThisContactDraft    String?
  recommendedChannel     Channel?
  recommendedNextAction  String?
  callerOpening          String?
  emailAngle             String?
  whatsappRecommendation String?

  /// Full, human-readable derivation of every point awarded. Rendered in the
  /// score tooltip so no number in the UI is unexplained.
  scoreBreakdown Json?

  assignedTo   String?
  assignedUser User?   @relation("AssignedCaller", fields: [assignedTo], references: [id])

  currentStatus  OutreachStatus @default(NEW)
  nextFollowUpAt DateTime?
  lastScoredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  callActivities     CallActivity[]
  emailActivities    EmailActivity[]
  whatsappActivities WhatsAppActivity[]
  scoreAudits        ScoreAudit[]

  @@unique([campaignId, contactId])
  @@index([campaignId, priority])
  @@index([assignedTo])
  @@index([currentStatus])
  @@index([totalScore])
  @@index([nextFollowUpAt])
}

/// Append-only ledger of engagement signals. pointsAwarded records what the
/// event contributed at the time it happened.
model EngagementEvent {
  id            String    @id @default(cuid())
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  eventType     EventType
  eventDate     DateTime  @default(now())
  metadata      Json?
  pointsAwarded Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([campaignId, contactId])
  @@index([eventType])
  @@index([eventDate])
}

model CallActivity {
  id                String          @id @default(cuid())
  campaignContactId String
  campaignContact   CampaignContact @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  callerId          String
  caller            User            @relation(fields: [callerId], references: [id])
  callDate          DateTime        @default(now())
  outcome           CallOutcome
  notes             String?
  nextAction        String?
  nextFollowUpAt    DateTime?
  durationSeconds   Int?
  createdAt         DateTime        @default(now())

  @@index([campaignContactId])
  @@index([callerId])
  @@index([outcome])
}

model EmailActivity {
  id                String          @id @default(cuid())
  campaignContactId String
  campaignContact   CampaignContact @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  emailType         EmailType
  subject           String
  body              String
  sentAt            DateTime?
  deliveryStatus    DeliveryStatus  @default(LOGGED_ONLY)
  openedAt          DateTime?
  clickedAt         DateTime?
  repliedAt         DateTime?
  replySentiment    ReplySentiment?
  unsubscribeAt     DateTime?
  /// Which provider handled it. "log" means nothing was transmitted.
  provider          String          @default("log")
  createdAt         DateTime        @default(now())

  @@index([campaignContactId])
  @@index([deliveryStatus])
}

model WhatsAppActivity {
  id                String              @id @default(cuid())
  campaignContactId String
  campaignContact   CampaignContact     @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  messageType       WhatsAppMessageType
  messageText       String
  sentAt            DateTime?
  deliveryStatus    DeliveryStatus      @default(LOGGED_ONLY)
  repliedAt         DateTime?
  optOutAt          DateTime?
  provider          String              @default("log")
  createdAt         DateTime            @default(now())

  @@index([campaignContactId])
}

/// Country-aware permission record. The application stores facts here and
/// evaluates them against configurable country rules; it does not hard-code
/// legal conclusions.
model ComplianceRecord {
  id              String        @id @default(cuid())
  contactId       String
  contact         Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  country         String
  consentStatus   ConsentStatus @default(NOT_CAPTURED)
  consentSource   String?
  consentDate     DateTime?
  lawfulBasis     LawfulBasis   @default(NOT_DETERMINED)
  noticeProvided  Boolean       @default(false)
  optOutStatus    OptOutStatus  @default(NONE)
  allowedChannels Channel[]     @default([])
  blockedChannels Channel[]     @default([])
  complianceNotes String?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?         @relation(fields: [reviewedById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([contactId])
  @@index([country])
  @@index([optOutStatus])
}

/// Per-campaign scoring weights. Validated to total 100 before persisting.
model ScoringConfig {
  id         String   @id @default(cuid())
  campaignId String   @unique
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  companyFitMax           Int @default(25)
  roleRelevanceMax        Int @default(25)
  triggerMax              Int @default(20)
  engagementMax           Int @default(15)
  dataQualityMax          Int @default(10)
  attendanceLikelihoodMax Int @default(5)

  /// Per-component point values, keyed by component code (see domain/scoring).
  componentWeights Json

  p1Threshold        Int @default(80)
  p2Threshold        Int @default(60)
  p3Threshold        Int @default(40)
  p1MinRoleRelevance Int @default(18)
  p1MinDataQuality   Int @default(7)

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Immutable history of score changes. Never updated, only inserted.
model ScoreAudit {
  id                String            @id @default(cuid())
  campaignContactId String
  campaignContact   CampaignContact   @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  previousTotal     Int?
  newTotal          Int
  previousPriority  Priority?
  newPriority       Priority
  reason            ScoreChangeReason
  detail            String?
  breakdown         Json?
  changedById       String?
  changedBy         User?             @relation(fields: [changedById], references: [id])
  createdAt         DateTime          @default(now())

  @@index([campaignContactId])
  @@index([createdAt])
}

/// Country-level compliance rules, editable by Admin. Deliberately data, not
/// code: legal posture differs per client and per jurisdiction.
model CountryComplianceRule {
  id                    String    @id @default(cuid())
  country               String    @unique
  /// Channels that may be used when consent is captured.
  permittedChannels     Channel[] @default([])
  /// Channels that are never used for this country under agency policy.
  prohibitedChannels    Channel[] @default([])
  /// If true, an explicit opt-in is required before any electronic outreach.
  requiresExplicitOptIn Boolean   @default(false)
  /// If true, WhatsApp requires a separate documented opt-in.
  whatsappRequiresOptIn Boolean   @default(true)
  /// If true, a lawful basis must be recorded before outreach is unblocked.
  requiresLawfulBasis   Boolean   @default(true)
  /// If true, a privacy notice must be recorded as provided.
  requiresNotice        Boolean   @default(false)
  /// Days after which a consent record is treated as stale.
  consentValidityDays   Int?
  policyNotes           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}
