# ---------------------------------------------------------------------------
# Project SIGNAL - environment configuration
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://signal:signal@localhost:5432/signal?schema=public"

# Data source for the repository layer.
#   postgres -> use Prisma against DATABASE_URL (production / normal dev)
#   memory   -> use the in-memory repository seeded with the same fixture data
#               (useful when no database is available; no code changes needed)
DATA_SOURCE="postgres"

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Session lifetime in seconds (default 8 hours).
SESSION_TTL_SECONDS="28800"

# Public application URL, used in email/WhatsApp previews and unsubscribe links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Agency identity used in the compliance footer of outbound messages.
NEXT_PUBLIC_AGENCY_NAME="Signal Demand Partners"
NEXT_PUBLIC_AGENCY_ADDRESS="1 Example Street, Toronto, ON M5H 2N2, Canada"
NEXT_PUBLIC_AGENCY_PRIVACY_URL="https://example.com/privacy"

# Outbound provider abstraction. Both default to "log": nothing is ever sent,
# messages are recorded in the database only. Swap for a real provider later.
EMAIL_PROVIDER="log"
WHATSAPP_PROVIDER="log"

# Password for every seeded demo user (seed script only).
SEED_PASSWORD="signal123"
