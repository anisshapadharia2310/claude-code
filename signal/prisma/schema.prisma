// ---------------------------------------------------------------------------
// Project SIGNAL - Scored Intent and Granular Account-Level Listbuilding
// ---------------------------------------------------------------------------
// Design notes:
//  * Every qualification decision must be explainable, so scores are stored
//    alongside a JSON explanation of the individual points that produced them.
//  * Relevance and compliance are modelled as gates that are evaluated
//    independently of the numeric score - a high score can never buy its way
//    past a failed gate.
//  * Compliance rules live in CountryComplianceRule rather than in code so that
//    legal conclusions are configuration, not hard-coded assumptions.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ ENUMS ========================================

enum UserRole {
  ADMIN
  RESEARCHER
  CALLER
  MANAGER
}

enum CampaignType {
  WHITE_PAPER
  WEBINAR
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/// Final qualification outcome for a contact within a campaign.
enum Priority {
  P1
  P2
  P3
  REJECT
  COMPLIANCE_HOLD
  UNSCORED
}

/// Configurable role taxonomy. A contact's category is derived from normalized
/// title + department + job function + responsibility flags - never from a bare
/// keyword match on the raw job title.
enum RoleCategory {
  DIRECT_OWNER
  OPERATIONAL_OWNER
  EXECUTIVE_SPONSOR
  TECHNICAL_EVALUATOR
  BUSINESS_INFLUENCER
  PROCUREMENT
  END_USER
  PERIPHERAL
  UNKNOWN
}

enum Seniority {
  C_LEVEL
  EVP
  SVP
  VP
  HEAD
  DIRECTOR
  SENIOR_MANAGER
  MANAGER
  TEAM_LEAD
  INDIVIDUAL_CONTRIBUTOR
  UNKNOWN
}

enum DecisionRole {
  DECISION_MAKER
  INFLUENCER
  EVALUATOR
  RECOMMENDER
  GATEKEEPER
  USER
  UNKNOWN
}

enum EmailStatus {
  VERIFIED
  VALID
  CATCH_ALL
  UNVERIFIED
  RISKY
  INVALID
  BOUNCED
  MISSING
}

enum PhoneStatus {
  VERIFIED
  VALID
  UNVERIFIED
  INVALID
  WRONG_NUMBER
  MISSING
}

enum WhatsAppStatus {
  AVAILABLE_OPTED_IN
  AVAILABLE_NO_CONSENT
  NOT_AVAILABLE
  OPTED_OUT
  BLOCKED_BY_POLICY
  UNKNOWN
}

enum ConsentStatus {
  EXPLICIT_OPT_IN
  SOFT_OPT_IN
  LEGITIMATE_INTEREST
  NOT_CAPTURED
  OPT_OUT
  DO_NOT_CONTACT
}

enum LawfulBasis {
  CONSENT
  LEGITIMATE_INTEREST
  CONTRACT
  LEGAL_OBLIGATION
  NOT_DETERMINED
}

enum OptOutStatus {
  NONE
  EMAIL_OPT_OUT
  PHONE_OPT_OUT
  WHATSAPP_OPT_OUT
  GLOBAL_OPT_OUT
}

enum Channel {
  EMAIL
  PHONE
  WHATSAPP
  LINKEDIN
}

/// How strong a consent record has to be before a channel may be used in a
/// given country. Configured per country by an administrator.
enum ConsentRequirement {
  EXPLICIT_OPT_IN_REQUIRED
  SOFT_OPT_IN_SUFFICIENT
  LEGITIMATE_INTEREST_SUFFICIENT
  CHANNEL_PROHIBITED
}

enum DataConfidence {
  HIGH
  MEDIUM
  LOW
  UNVERIFIED
}

enum EmployeeBand {
  BAND_1_50
  BAND_51_200
  BAND_201_500
  BAND_501_1000
  BAND_1001_5000
  BAND_5001_10000
  BAND_10001_PLUS
  UNKNOWN
}

enum RevenueBand {
  LT_10M
  FROM_10M_50M
  FROM_50M_250M
  FROM_250M_1B
  FROM_1B_5B
  GT_5B
  UNKNOWN
}

enum ClientRelationship {
  NONE
  PROSPECT_IN_PIPELINE
  PAST_CLIENT
  CURRENT_CLIENT
  PARTNER
}

enum TriggerVerification {
  UNVERIFIED
  VERIFIED
  FALSE_POSITIVE
}

enum HumanReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  DOWNGRADED
  REJECTED
}

enum OutreachStatus {
  NEW
  ASSIGNED
  ATTEMPTED
  CONTACTED
  ENGAGED
  REGISTERED
  ATTENDED
  MEETING_REQUESTED
  NURTURE
  NOT_INTERESTED
  DO_NOT_CONTACT
  REJECTED
}

enum EventType {
  WHITEPAPER_SENT
  WHITEPAPER_DELIVERED
  WHITEPAPER_OPENED
  WHITEPAPER_DOWNLOADED
  EMAIL_SENT
  EMAIL_DELIVERED
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_REPLIED
  POSITIVE_EMAIL_REPLY
  WEBINAR_INVITATION_SENT
  WEBINAR_REGISTERED
  WEBINAR_ATTENDED
  WEBINAR_ATTENDANCE_50_PERCENT
  WEBINAR_ATTENDANCE_75_PERCENT
  WEBINAR_ATTENDANCE_80_PERCENT
  STAYED_FOR_QA
  POLL_ANSWERED
  QUESTION_ASKED
  RESOURCE_DOWNLOADED
  CTA_CLICKED
  REPLAY_WATCHED
  MEETING_REQUESTED
  CALL_CONNECTED
  CALL_NO_ANSWER
  CALL_CALLBACK_REQUESTED
  NOT_INTERESTED
  OPTED_OUT
}

enum CallOutcome {
  CONNECTED
  NO_ANSWER
  BUSY
  CALLBACK_REQUESTED
  INTERESTED
  SENT_WHITEPAPER
  SENT_WEBINAR_LINK
  REGISTERED
  NOT_RELEVANT
  NOT_INTERESTED
  WRONG_NUMBER
  DO_NOT_CONTACT
}

enum EmailType {
  WHITEPAPER_OFFER
  WEBINAR_INVITE
  REMINDER
  FOLLOW_UP
  REPLAY
  CUSTOM
}

enum DeliveryStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
  LOGGED_MANUALLY
}

enum ReplySentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  OUT_OF_OFFICE
  UNSUBSCRIBE
}

enum WhatsAppMessageType {
  INTRODUCTION
  WEBINAR_INVITE
  REMINDER
  LINK_SHARE
  FOLLOW_UP
  CUSTOM
}

enum ImportStatus {
  UPLOADED
  MAPPED
  VALIDATED
  COMMITTED
  CANCELLED
}

enum ImportRowStatus {
  VALID
  INVALID
  DUPLICATE
  CORRECTED
  SKIPPED
  IMPORTED
}

/// What caused a score to change - kept for the audit history.
enum ScoreChangeSource {
  IMPORT
  SCORING_ENGINE
  ENGAGEMENT_EVENT
  CALL_OUTCOME
  HUMAN_REVIEW
  WEIGHT_CHANGE
  COMPLIANCE_UPDATE
}

// ============================ MODELS =======================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole @default(RESEARCHER)
  /// scrypt hash in the form <salt>:<derivedKey>. Simple by design; swap for a
  /// managed identity provider without touching callers of lib/auth.
  passwordHash String
  isActive     Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedCampaignContacts CampaignContact[] @relation("AssignedTo")
  reviewedCampaignContacts CampaignContact[] @relation("ReviewedBy")
  callActivities           CallActivity[]
  importBatches            ImportBatch[]
  scoreAudits              ScoreAudit[]
  complianceReviews        ComplianceRecord[]

  @@index([role])
}

model Account {
  id                        String   @id @default(cuid())
  companyName               String
  domain                    String?
  industry                  String
  subIndustry               String?
  country                   String
  city                      String?
  region                    String?
  timeZone                  String?
  language                  String?
  employeeBand              EmployeeBand @default(UNKNOWN)
  revenueBand               RevenueBand  @default(UNKNOWN)
  numberOfLocations         Int?
  existingTechnology        String[]     @default([])
  competitorTechnology      String[]     @default([])
  namedAccountStatus        Boolean      @default(false)
  existingClientRelationship ClientRelationship @default(NONE)

  // --- Business trigger signals (component C of the scoring engine) --------
  recentBusinessTrigger     String?
  relevantOpenJobPostings   Int          @default(0)
  transformationActivity    Boolean      @default(false)
  expansionActivity         Boolean      @default(false)
  mergerOrAcquisitionActivity Boolean    @default(false)
  leadershipChange          Boolean      @default(false)
  regulatoryPressure        Boolean      @default(false)
  publiclyStatedPriority    Boolean      @default(false)
  triggerSource             String?
  triggerDate               DateTime?
  triggerVerification       TriggerVerification @default(UNVERIFIED)

  accountNotes              String?
  accountDataConfidence     DataConfidence @default(MEDIUM)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  contacts Contact[]

  @@unique([companyName, country])
  @@index([domain])
  @@index([industry])
  @@index([country])
}

model Contact {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  // --- Role decomposition. The whole point of SIGNAL is that jobTitle alone
  // --- is never sufficient, so responsibility is stored explicitly.
  jobTitle                    String
  normalizedJobTitle          String
  department                  String?
  jobFunction                 String?
  roleCategory                RoleCategory @default(UNKNOWN)
  seniority                   Seniority    @default(UNKNOWN)
  decisionRole                DecisionRole @default(UNKNOWN)
  ownsBudget                  Boolean      @default(false)
  influencesDecision          Boolean      @default(false)
  directProblemResponsibility Boolean      @default(false)
  roleRelevanceNotes          String?
  roleConfidence              DataConfidence @default(UNVERIFIED)
  tenureMonths                Int?

  country  String
  city     String?
  timeZone String?
  language String?

  workEmail       String?
  emailStatus     EmailStatus @default(MISSING)
  emailConfidence DataConfidence @default(UNVERIFIED)
  phoneNumber     String?
  phoneStatus     PhoneStatus @default(MISSING)
  whatsappStatus  WhatsAppStatus @default(UNKNOWN)
  linkedinUrl     String?

  contactSource  String?
  lastVerifiedAt DateTime?

  consentStatus            ConsentStatus @default(NOT_CAPTURED)
  communicationRestrictions String[]     @default([])
  contactNotes             String?

  isDuplicate   Boolean  @default(false)
  duplicateOfId String?
  duplicateOf   Contact?  @relation("ContactDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Contact[] @relation("ContactDuplicate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignContacts  CampaignContact[]
  engagementEvents  EngagementEvent[]
  complianceRecords ComplianceRecord[]
  importRows        ImportRow[]

  @@index([accountId])
  @@index([workEmail])
  @@index([phoneNumber])
  @@index([roleCategory])
  @@index([country])
}

model Campaign {
  id          String       @id @default(cuid())
  name        String
  clientBrand String
  campaignType CampaignType
  topic       String
  targetBusinessProblem String
  description String?

  // --- Targeting criteria (component A of the scoring engine) -------------
  targetIndustries    String[] @default([])
  targetSubIndustries String[] @default([])
  targetCountries     String[] @default([])
  targetCities        String[] @default([])
  targetEmployeeBands EmployeeBand[] @default([])
  targetRevenueBands  RevenueBand[]  @default([])
  targetTechnologies  String[] @default([])
  targetJobFunctions  String[] @default([])
  targetRoleCategories RoleCategory[] @default([])
  targetSeniorities   Seniority[] @default([])
  preferredLanguages  String[] @default([])

  /// Role categories the administrator has marked as relevant for this
  /// campaign. A contact outside this set can never reach P1.
  relevantRoleCategories RoleCategory[] @default([])

  /// Terms that describe genuine ownership of the campaign problem. Used
  /// together with department/function/responsibility - never on their own.
  problemOwnershipTerms String[] @default([])

  /// The naive keyword filter the agency used before SIGNAL. Stored only so the
  /// dashboard can compare the old method against the SIGNAL method.
  surfaceTitleKeywords String[] @default([])

  eventDate     DateTime?
  eventTime     String?
  eventTimeZone String?
  speakerInformation String?
  registrationUrl String?
  whitePaperUrl   String?

  /// Per-campaign scoring weights. Must total 100; validated with Zod before
  /// being persisted. Null means "use the default 100-point model".
  scoringWeights Json?

  /// Total campaign cost, used for cost-per-verified-attendee on the dashboard.
  campaignCost Decimal? @db.Decimal(12, 2)
  currency     String   @default("USD")

  status    CampaignStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignContacts CampaignContact[]
  engagementEvents EngagementEvent[]
  importBatches    ImportBatch[]

  @@index([status])
}

/// A contact's participation in one campaign: the scored, gated, explained
/// qualification record that the whole application revolves around.
model CampaignContact {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // --- Component scores (A-F) --------------------------------------------
  fitScore                  Int @default(0)
  roleRelevanceScore        Int @default(0)
  triggerScore              Int @default(0)
  engagementScore           Int @default(0)
  dataQualityScore          Int @default(0)
  attendanceLikelihoodScore Int @default(0)
  totalScore                Int @default(0)

  /// Points contributed by post-webinar engagement events, tracked separately
  /// so the base qualification score stays visible and explainable.
  engagementBonus Int @default(0)

  priority Priority @default(UNSCORED)

  relevanceGatePassed  Boolean @default(false)
  complianceGatePassed Boolean @default(false)

  /// Full breakdown of every point awarded: [{ code, label, points, max, reason }]
  scoreExplanation Json?
  /// Result of each individual relevance / compliance check.
  gateResults      Json?

  humanReviewRequired Boolean @default(false)
  humanReviewStatus   HumanReviewStatus @default(NOT_REQUIRED)
  reviewedById        String?
  reviewedBy          User?    @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  reviewNotes         String?

  /// Mandatory for P1 - a contact cannot be promoted without a written reason.
  whyThisContact String?

  recommendedChannel    Channel?
  recommendedNextAction String?
  callerOpening         String?
  emailAngle            String?
  whatsappRecommended   Boolean @default(false)

  /// True when the agency's pre-SIGNAL surface filter would also have selected
  /// this contact. Powers the "old method versus SIGNAL method" comparison.
  surfaceLevelMatch Boolean @default(false)

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  currentStatus  OutreachStatus @default(NEW)
  nextFollowUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  callActivities     CallActivity[]
  emailActivities    EmailActivity[]
  whatsappActivities WhatsAppActivity[]
  scoreAudits        ScoreAudit[]

  @@unique([campaignId, contactId])
  @@index([campaignId, priority])
  @@index([assignedToId])
  @@index([currentStatus])
  @@index([totalScore])
}

model EngagementEvent {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  eventType     EventType
  eventDate     DateTime  @default(now())
  metadata      Json?
  pointsAwarded Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([campaignId, contactId])
  @@index([eventType])
  @@index([eventDate])
}

model CallActivity {
  id                String          @id @default(cuid())
  campaignContactId String
  campaignContact   CampaignContact @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  callerId          String?
  caller            User?           @relation(fields: [callerId], references: [id], onDelete: SetNull)

  callDate       DateTime    @default(now())
  outcome        CallOutcome
  notes          String?
  nextAction     String?
  nextFollowUpAt DateTime?
  createdAt      DateTime    @default(now())

  @@index([campaignContactId])
  @@index([callerId])
}

model EmailActivity {
  id                String          @id @default(cuid())
  campaignContactId String
  campaignContact   CampaignContact @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)

  emailType      EmailType      @default(CUSTOM)
  subject        String
  body           String
  sentAt         DateTime?
  deliveryStatus DeliveryStatus @default(DRAFT)
  openedAt       DateTime?
  clickedAt      DateTime?
  repliedAt      DateTime?
  replySentiment ReplySentiment?
  unsubscribeAt  DateTime?
  /// "log" while no provider is connected; set by the provider abstraction.
  provider       String @default("log")
  createdAt      DateTime @default(now())

  @@index([campaignContactId])
}

model WhatsAppActivity {
  id                String          @id @default(cuid())
  campaignContactId String
  campaignContact   CampaignContact @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)

  messageType    WhatsAppMessageType @default(CUSTOM)
  messageText    String
  sentAt         DateTime?
  deliveryStatus DeliveryStatus      @default(DRAFT)
  repliedAt      DateTime?
  optOutAt       DateTime?
  provider       String              @default("log")
  createdAt      DateTime            @default(now())

  @@index([campaignContactId])
}

model ComplianceRecord {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  country         String
  consentStatus   ConsentStatus @default(NOT_CAPTURED)
  consentSource   String?
  consentDate     DateTime?
  lawfulBasis     LawfulBasis   @default(NOT_DETERMINED)
  noticeProvided  Boolean       @default(false)
  optOutStatus    OptOutStatus  @default(NONE)
  allowedChannels Channel[]     @default([])
  blockedChannels Channel[]     @default([])
  complianceNotes String?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?         @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([country])
}

/// Country-level compliance configuration. Kept in the database, editable by an
/// administrator, so the application never hard-codes a legal conclusion.
model CountryComplianceRule {
  id      String @id @default(cuid())
  country String @unique

  emailRequirement    ConsentRequirement @default(LEGITIMATE_INTEREST_SUFFICIENT)
  phoneRequirement    ConsentRequirement @default(LEGITIMATE_INTEREST_SUFFICIENT)
  whatsappRequirement ConsentRequirement @default(EXPLICIT_OPT_IN_REQUIRED)

  /// Fields that must be present on the ComplianceRecord before outreach is
  /// allowed in this country. Missing fields produce COMPLIANCE_HOLD.
  requiredFields String[] @default([])
  noticeRequired Boolean  @default(false)
  notes          String?

  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Immutable audit trail of score and priority changes.
model ScoreAudit {
  id                String          @id @default(cuid())
  campaignContactId String
  campaignContact   CampaignContact @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)

  source           ScoreChangeSource
  reason           String
  previousTotal    Int?
  newTotal         Int
  previousPriority Priority?
  newPriority      Priority
  /// Per-component before/after values.
  delta            Json?

  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([campaignContactId, createdAt])
}

model ImportBatch {
  id         String    @id @default(cuid())
  fileName   String
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  status        ImportStatus @default(UPLOADED)
  columnMapping Json?
  totalRows     Int @default(0)
  validRows     Int @default(0)
  invalidRows   Int @default(0)
  duplicateRows Int @default(0)
  importedRows  Int @default(0)
  skippedRows   Int @default(0)
  summary       Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  rows ImportRow[]
}

model ImportRow {
  id      String      @id @default(cuid())
  batchId String
  batch   ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  rowNumber      Int
  rawData        Json
  normalizedData Json?
  status         ImportRowStatus @default(VALID)
  errors         Json?
  warnings       Json?

  duplicateOfContactId String?
  contactId            String?
  contact              Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([batchId, status])
}
