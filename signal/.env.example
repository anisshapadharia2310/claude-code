# ---------------------------------------------------------------------------
# Project SIGNAL - environment variables
# Copy to .env and adjust for your environment:  cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://signal:signal@localhost:5432/signal?schema=public"

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Password shared by all seeded demo users (development convenience only).
SEED_USER_PASSWORD="signal123"

# Public base URL, used when building absolute links in exports/emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Provider abstractions -------------------------------------------------
# The first version never sends real messages. Both providers default to "log",
# which records the activity in the database and marks it as manually logged.
# Set to "smtp"/"sendgrid" or "twilio"/"meta" once a real provider is wired up.
EMAIL_PROVIDER="log"
WHATSAPP_PROVIDER="log"

# EMAIL_FROM_NAME="SIGNAL Outbound"
# EMAIL_FROM_ADDRESS="campaigns@example.com"
# EMAIL_API_KEY=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# WHATSAPP_API_KEY=""

# Compliance footer appended to every outbound email draft.
COMPLIANCE_FOOTER_COMPANY="Example Outbound Agency Ltd."
COMPLIANCE_FOOTER_ADDRESS="1 Example Street, London, EC1A 1AA, United Kingdom"
